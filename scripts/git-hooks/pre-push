#!/bin/bash
set -euo pipefail

if [ -z "${AI_NEWS_MIN_ITEMS:-}" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
validator="${AI_NEWS_VALIDATOR:-$repo_root/scripts/validate_daily_news.py}"
python_bin="${AI_NEWS_PYTHON_BIN:-python3}"
validate_revision() {
  "$python_bin" "$validator" \
  --repo "$repo_root" \
  --date "${AI_NEWS_DATE:-$(date +%Y-%m-%d)}" \
  --min-items "$AI_NEWS_MIN_ITEMS" \
  --revision "$1"
}

# 作業ツリーではなく、実際にpushするコミットの内容を検査する。
validate_revision HEAD
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [[ "$local_sha" =~ ^0+$ ]] && continue
  validate_revision "$local_sha"
done
