;; macOS cannot apply Codex's Seatbelt inside this Seatbelt. This is the sole
;; filesystem boundary for Codex and every command it starts. Codex retains
;; network access for authentication and WebSearch.
(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath (param "SCRATCH_DIR")))
(allow file-write* (literal "/dev/null"))
;; Hide the user's home (including other repositories and Git/SSH credentials).
;; Codex gets an ephemeral HOME and auth copy inside this run's scratch directory.
(deny file-read* (subpath (param "HOME_DIR")))
(deny file-read* (literal (param "CODEX_AUTH_SOURCE")))
;; Previous scratch runs may contain private work. Only this run is readable.
(deny file-read* (subpath (param "SCRATCH_BASE_DIR")))
(allow file-read-metadata (literal (param "SCRATCH_BASE_DIR")))
(allow file-read* (subpath (param "SCRATCH_DIR")))
(deny file-read* file-write* (subpath (param "REPO_DIR")))
(deny file-read* file-write* (literal (param "SSH_AUTH_SOCKET")))
;; Keep preferences services available to Codex; block keychain IPC.
(deny mach-lookup (regex #".*[Ss]ecurity.*|.*[Kk]eychain.*"))
