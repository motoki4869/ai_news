;; The Codex process needs its own login and network connection. Its model-run
;; commands get a second, network-disabled workspace-write sandbox from Codex.
;; This outer macOS boundary denies the original repository and Git credentials
;; even when a command uses an absolute path or bypasses PATH shims.
(version 1)
(allow default)
(deny file-read* file-write* (subpath (param "REPO_DIR")))
(deny file-read* file-write* (subpath (param "SSH_DIR")))
(deny file-read* file-write* (subpath (param "GH_DIR")))
(deny file-read* file-write* (subpath (param "GIT_CONFIG_DIR")))
(deny file-read* file-write* (subpath (param "KEYCHAIN_DIR")))
(deny file-read* file-write* (literal (param "GIT_CONFIG_FILE")))
(deny file-read* file-write* (literal (param "GIT_CREDENTIALS_FILE")))
(deny file-read* file-write* (literal (param "NETRC_FILE")))
(deny file-read* file-write* (literal (param "SSH_AUTH_SOCKET")))
;; securityd uses more than one Mach service name. Deny every Mach lookup so
;; git-credential-osxkeychain cannot use a service omitted from this list.
(deny mach-lookup)
(allow mach-lookup (global-name "com.apple.cfprefsd.xpc.agent"))
(allow mach-lookup (global-name "com.apple.cfprefsd.xpc.daemon"))
